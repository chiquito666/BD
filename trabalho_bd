  
CREATE TABLE CLIENTE (
    ID INT AUTO_INCREMENT PRIMARY KEY,
    Nome VARCHAR(100) NOT NULL,
    CPF VARCHAR(14) NOT NULL UNIQUE
);

CREATE TABLE ENDERECO (
    ID INT AUTO_INCREMENT PRIMARY KEY,
    idCLIENTE INT NOT NULL,
    Rua VARCHAR(150) NOT NULL,
    Número VARCHAR(20) NOT NULL,
    Bairro VARCHAR(100) NOT NULL,
    Cidade VARCHAR(100) NOT NULL,
    CEP VARCHAR(10) NOT NULL,
    Complemento VARCHAR(100),
    CONSTRAINT fk_cliente_endereco FOREIGN KEY (idCLIENTE) REFERENCES CLIENTE(ID)
);

CREATE TABLE COMPRA (
    ID INT AUTO_INCREMENT PRIMARY KEY,
    idCLIENTE INT NOT NULL,
    idENDEREÇO INT NOT NULL,
    Data DATETIME NOT NULL,
    Forma_pag VARCHAR(50) NOT NULL,
    CONSTRAINT fk_cliente_compra FOREIGN KEY (idCLIENTE) REFERENCES CLIENTE(ID),
    CONSTRAINT fk_endereco_compra FOREIGN KEY (idENDEREÇO) REFERENCES ENDEREÇO(ID)
);

CREATE TABLE PRODUTO (
    ID INT AUTO_INCREMENT PRIMARY KEY,
    Nome VARCHAR(100) NOT NULL,
    Descrição TEXT,
    Categoria VARCHAR(50) NOT NULL,
    Preço DECIMAL(10, 2) NOT NULL,
    Quantidade INT NOT NULL
);

CREATE TABLE TEM (
    idCOMPRA INT NOT NULL,
    idPRODUTO INT NOT NULL,
    Quantidade INT NOT NULL,
    Valor_Unitario DECIMAL(10, 2) NOT NULL,
    Desconto DECIMAL(5, 2) DEFAULT 0.00,
    PRIMARY KEY (idCOMPRA, idPRODUTO),
    CONSTRAINT fk_compra_tem FOREIGN KEY (idCOMPRA) REFERENCES COMPRA(ID),
    CONSTRAINT fk_produto_tem FOREIGN KEY (idPRODUTO) REFERENCES PRODUTO(ID)
);
